// Prisma schema for the Kids Gaming & Educational App
// Access is via a plain DATABASE_URL connection string only (Supabase today,
// self-hosted Postgres in Docker Compose tomorrow) — no provider-specific features.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GradeLevel {
  PRE_K
  K
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH
}

enum TimerStatus {
  ACTIVE
  ENDED
  EXPIRED
}

model Parent {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  kids         Kid[]
  trackRecords TrackRecord[]
}

model Kid {
  id                String     @id @default(cuid())
  parentId          String
  parent            Parent     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name              String
  avatar            String     @default("fox")
  pin               String?
  mathGradeLevel    GradeLevel @default(K)
  readingGradeLevel GradeLevel @default(K)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  gameSessions  GameSession[]
  timerSessions TimerSession[]
  carProgress   CarProgress?
  trackRecords  TrackRecord[]
  farmProgress  FarmProgress?
}

model GameSession {
  id        String    @id @default(cuid())
  kidId     String
  kid       Kid       @relation(fields: [kidId], references: [id], onDelete: Cascade)
  gameType  String
  subject   String
  skillTag  String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  score     Int?
  accuracy  Float?

  @@index([kidId, gameType])
  @@index([kidId, subject, skillTag])
}

model TimerSession {
  id              String      @id @default(cuid())
  kidId           String
  kid             Kid         @relation(fields: [kidId], references: [id], onDelete: Cascade)
  startedAt       DateTime    @default(now())
  durationMinutes Int
  endedAt         DateTime?
  status          TimerStatus @default(ACTIVE)

  @@index([kidId, status])
}

// One row per kid: their racing-game currency and car customization/upgrades.
model CarProgress {
  id          String   @id @default(cuid())
  kidId       String   @unique
  kid         Kid      @relation(fields: [kidId], references: [id], onDelete: Cascade)
  coins       Int      @default(0)
  engineLevel Int      @default(1)
  wheelsLevel Int      @default(1)
  turboLevel  Int      @default(1)
  color       String   @default("red")
  updatedAt   DateTime @updatedAt
}

// Best time per track, scoped to the family (Parent), not per kid — whichever
// kid under the account is fastest holds the record, matching a shared
// household leaderboard rather than separate per-kid leaderboards.
model TrackRecord {
  id        String   @id @default(cuid())
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  trackId   String
  kidId     String
  kid       Kid      @relation(fields: [kidId], references: [id], onDelete: Cascade)
  timeMs    Int
  createdAt DateTime @default(now())

  @@unique([parentId, trackId])
}

// One row per kid: their farm-game currency, land, upgrades, and plot state.
// Plots are small/bounded (max 10) so they're stored as a JSON array rather
// than a separate table — each entry is either null (empty) or
// { crop: string, plantedAt: ISO string }.
model FarmProgress {
  id              String   @id @default(cuid())
  kidId           String   @unique
  kid             Kid      @relation(fields: [kidId], references: [id], onDelete: Cascade)
  coins           Int      @default(50)
  landLevel       Int      @default(4)
  wateringLevel   Int      @default(1)
  fertilizerLevel Int      @default(1)
  plots           Json     @default("[]")
  updatedAt       DateTime @updatedAt
}
